  "version": "0.1.0",
  "type": "module",
  "description": "Hackathon demo",
  "main": "libs/app.js",
  "AppID": "100064285",
  "config": {
    "env": "fws",
    "port": 18085
  },
  "scripts": {
    "dev": "vite --port 5173",
