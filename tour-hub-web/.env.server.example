# 服务端专用。复制为 .env.server.local（已忽略）；私钥不得使用 VITE_ 前缀。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 可选：Studio 联网补充灵感（搜索 + 读取搜索结果正文）；不配时使用已有景点资料。
TAVILY_API_KEY=
# 可选：Studio 逐章生成插画。填写账号实际可用的模型 ID，每次操作在界面显式确认。
ARK_API_KEY=
ARK_IMAGE_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 默认素材位于应用 .agent-jobs/assets；可指定持久目录（不会随 Git 推送）。
# AGENT_ARTIFACT_DIR=/your/persistent/agent-artifacts
# 如使用自定义前端域名，请列出允许的 Origin，逗号分隔。
# WEB_ORIGIN=https://your-preview.example
