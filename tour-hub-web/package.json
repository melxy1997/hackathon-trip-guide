{
  "name": "trip-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "dev:api": "node --env-file-if-exists=.env.server.local server/index.ts",
    "dev:full": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test src/experience/__tests__/*.test.ts server/__tests__/*.test.ts",
    "test:smoke": "node scripts/smoke-experience.mjs",
    "test:builder": "node scripts/smoke-builder.mjs",
    "test:studio": "node scripts/smoke-studio.mjs",
    "agent:rehearse": "node scripts/agent-rehearse.mjs",
    "test:playability": "node scripts/smoke-playability.mjs",
    "test:offline": "node scripts/smoke-offline.mjs",
    "test:creator": "node scripts/smoke-creator.mjs",
    "test:dual": "node scripts/smoke-dual.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@xyflow/react": "12.12.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
