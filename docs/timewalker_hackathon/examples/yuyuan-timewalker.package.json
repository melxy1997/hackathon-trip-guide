      },
      {
        "id": "rockery", "spotId": "da-jia-shan", "title": "第二幕：山水有意", "mode": "cinematic",
        "blocks": [
          { "id": "rockery-image", "type": "image", "assetRef": "/spots/da-jia-shan.jpg" },
          { "id": "rockery-voice", "type": "narration", "text": "在大假山前停一停。园林不仅是建筑的集合，也有对山水与自然的想象。如果只选一个方向理解它，你会更在意天然野趣，还是人的精巧营造？", "fictional": true, "sourceIds": ["shanghai-gov"] }
        ],
        "interaction": {
          "id": "aesthetic-choice", "type": "single_choice",
          "options": [
            { "id": "nature", "label": "山林野趣：我想看天然之美", "actions": [{ "type": "setVar", "key": "aestheticLens", "value": "nature" }, { "type": "goTo", "sceneId": "jade-nature" }] },
            { "id": "craft", "label": "匠心造景：我想看人工之巧", "actions": [{ "type": "setVar", "key": "aestheticLens", "value": "craft" }, { "type": "goTo", "sceneId": "jade-craft" }] }
          ]
        }
      },
      {
        "id": "jade-nature", "spotId": "yu-ling-long", "title": "第三幕：石中自然", "mode": "observation",
        "blocks": [
          { "id": "jade-image-n", "type": "image", "assetRef": "/spots/yu-ling-long.jpg" },
          { "id": "jade-voice-n", "type": "narration", "text": "你刚才选择了山林野趣。请看玉玲珑的轮廓、孔洞与光影：对于赏石的人来说，自然生成的变化本身就可以成为观赏对象。", "fictional": false, "sourceIds": ["shanghai-gov", "yuyuan-official"] }
        ],
        "interaction": { "id": "jade-observation-n", "type": "photo_or_tap", "prompt": "找一处让你想到山林的轮廓、孔洞或光影。", "hints": ["先看整块石头的外轮廓。", "再找一个像山洞、云朵或水流的局部。"], "fallback": "manual_confirm", "actionsOnComplete": [{ "type": "setVar", "key": "observedJade", "value": true }, { "type": "revealMemory", "memoryId": "jade-observed" }, { "type": "goTo", "sceneId": "epilogue" }] }
      },
      {
        "id": "jade-craft", "spotId": "yu-ling-long", "title": "第三幕：石与匠心", "mode": "observation",
        "blocks": [
          { "id": "jade-image-c", "type": "image", "assetRef": "/spots/yu-ling-long.jpg" },
          { "id": "jade-voice-c", "type": "narration", "text": "你刚才选择了匠心造景。请想象造园者如何选择一块独特的石头，又怎样安排它与周围的亭台、道路和视线；我们不只是欣赏一块石头，也在理解园林的构图。", "fictional": true, "sourceIds": ["yuyuan-official"] }
        ],
        "interaction": { "id": "jade-observation-c", "type": "photo_or_tap", "prompt": "找一处让你感受到造园安排的边缘、孔洞或视线关系。", "hints": ["先看石头与周围空间怎样相接。", "再想象站在不同方向时，这个细节会怎样改变画面。"], "fallback": "manual_confirm", "actionsOnComplete": [{ "type": "setVar", "key": "observedJade", "value": true }, { "type": "revealMemory", "memoryId": "jade-observed" }, { "type": "goTo", "sceneId": "epilogue" }] }
