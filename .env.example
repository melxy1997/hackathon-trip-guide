# 发布平台的运行时变量优先于本文件。本地开发可复制为 .env 后填写。
AMAP_KEY=your-amap-js-api-key
AMAP_SECURITY_CODE=your-amap-security-js-code
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=http://ada-cli-golang.ctripcorp.com/coding-plan/openai/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash

# Builder Agent（密钥仅在服务端读取；配置后重启）
TAVILY_API_KEY=
BUILDER_MAX_MODEL_CALLS=12
BUILDER_MAX_WEB_SEARCHES=4
BUILDER_JOB_TIMEOUT_MS=240000
